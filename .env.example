# Local Compose defaults are intentionally non-production values.
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema_dev_only

# Allowed frontend origins for CORS (comma-separated, no wildcard)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Inter-service base URLs for local development
CATALOG_BASE_URL=http://localhost:8081
BOOKING_BASE_URL=http://localhost:8082

